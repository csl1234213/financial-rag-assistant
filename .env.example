# ============================================================
# Financial Research Copilot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env              # development
#   cp .env.example .env.production   # production
#   cp .env.example .env.test         # testing
# ============================================================

# =========================
# App
# =========================

APP_ENV=development
APP_VERSION=8.1.0
LOG_LEVEL=INFO

# Hugging Face embedding model pinned to an immutable upstream commit for
# reproducible retrieval behavior.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DEVICE=
# JWT signing key.  Set this through a local .env file or your deployment
# secret manager; production refuses missing or placeholder values.
AUTH_SECRET_KEY=
# SECRET_KEY is accepted only as a backwards-compatible alias for AUTH_SECRET_KEY.

# =========================
# API
# =========================

API_HOST=0.0.0.0
API_PORT=8000

# =========================
# Database
# =========================

# Local Python development (outside Docker Compose)
DATABASE_URL=sqlite:///./financial_rag.db

# Docker Compose constructs its internal DATABASE_URL from these values.
# Use non-placeholder, URL-safe values in production and keep the real .env
# outside version control.
POSTGRES_USER=financial
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_DB=financial_rag

# =========================
# Redis
# =========================

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# Docker Compose protects Redis with this password and constructs an internal
# REDIS_URL for the API and worker.
REDIS_PASSWORD=change-me-before-production

# =========================
# ChromaDB (Vector Store)
# =========================

CHROMA_PATH=chroma_db
# Leave blank to use the local persistent client. Docker Compose overrides
# this with the internal `chromadb` service name.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false

# =========================
# Storage
# =========================

UPLOAD_DIR=storage/uploads
PDF_DIR=storage/pdfs

# =========================
# LLM — Unified Provider
# =========================

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_MODEL_NAME=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_STREAM=false

# =========================
# Gemini
# =========================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =========================
# HuggingFace
# =========================

HF_ENDPOINT=https://hf-mirror.com

# =========================
# Worker
# =========================

WORKER_CONCURRENCY=2
WORKER_POLL_TIMEOUT=1.0
MAX_TASK_RUNTIME=3600
WORKER_ID=agent-worker-1

# =========================
# Frontend (Vite)
# =========================

VITE_API_BASE_URL=/api
VITE_ENABLE_MOCK=false

# =========================
# Rate Limiting
# =========================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =========================
# Security
# =========================

# Comma-separated browser origins.  Development defaults to localhost:5173
# when this variable is unset; set explicit public origins in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
