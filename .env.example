# ============================================================
# Financial Research Copilot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env              # development
#   cp .env.example .env.production   # production
#   cp .env.example .env.test         # testing
# ============================================================

# =========================
# App
# =========================

APP_ENV=development
APP_VERSION=8.1.0
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret-key

# =========================
# API
# =========================

API_HOST=0.0.0.0
API_PORT=8000

# =========================
# Database
# =========================

# SQLite (development)
DATABASE_URL=sqlite:///./financial_rag.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://financial:financial_secret@localhost:5432/financial_rag

POSTGRES_USER=financial
POSTGRES_PASSWORD=financial_secret
POSTGRES_DB=financial_rag

# =========================
# Redis
# =========================

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# =========================
# ChromaDB (Vector Store)
# =========================

CHROMA_PATH=chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000

# =========================
# Storage
# =========================

UPLOAD_DIR=storage/uploads
PDF_DIR=storage/pdfs

# =========================
# LLM — Unified Provider
# =========================

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_MODEL_NAME=deepseek-chat
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_STREAM=false

# =========================
# Gemini
# =========================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =========================
# HuggingFace
# =========================

HF_ENDPOINT=https://hf-mirror.com

# =========================
# Worker
# =========================

WORKER_CONCURRENCY=2
WORKER_POLL_TIMEOUT=1.0
MAX_TASK_RUNTIME=3600
WORKER_ID=agent-worker-1

# =========================
# Frontend (Vite)
# =========================

VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_MOCK=false

# =========================
# UI (Streamlit - Legacy)
# =========================

STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

PAGE_TITLE=Financial Research Copilot
PAGE_LAYOUT=wide

API_BASE_URL=http://financial-api:8000

UPLOAD_DIR=/app/uploads

# =========================
# Rate Limiting
# =========================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =========================
# Security
# =========================

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
